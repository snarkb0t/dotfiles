// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 4, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)

    "margin": "6 6 6 6",

    // Choose the order of the modules
    "modules-left": [
	"custom/power",
    "hyprland/workspaces",
	"wlr/taskbar"
    ],
    "modules-center": [
        //"custom/gputemp",
        "clock"//,
        //"temperature"
    ],
    "modules-right": [
    "tray",
    "pulseaudio"
    ],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    
    "wlr/taskbar": {
	"icon-size": 24,
	"format": " {icon} ", 
	"all-outputs": true,
	"on-click": "activate",
	"sort-by-app-id": true,
	
    },

    "custom/lrcsnc": {
        "exec": "/usr/bin/lrcsnc",
        //"return-type": "json",
	"restart-interval": 1,
        "hide-empty-text": true,
        "max-length": 100,
        "tooltip": true,
        "escape": true,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "cava": {
	"cava_config":"~/.config/cava/config"
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "on-click": "activate"
        // Window rewrites omitted for brevity
    },

    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {
           "TelegramDesktop": "~/.local/share/icons/hicolor/16x16/apps/telegram.png"
        }
    },
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        //"format": "{:%e %b %Y | %H:%M:%S}",
	"format": "{:%H:%M:%S}",
	"interval": 1
    },
    "cpu": {
        "format": "CPU: {usage}% | {icon0} {icon1} {icon2} {icon3} {icon4} {icon5} {icon6} ",
	"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip": true,
	"interval": 1
    },
    "memory": {
        "format": "{used} GiB",
	"tooltip": true,
	"interval": 1
    },

    "custom/gputemp": {
	"format": "{text}°C",
	"exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
	"return-type": "stdout",
	"restart-interval": 1
    },

    "custom/cava": {
	"exec": "sleep 3 && cava -p /etc/xdg/waybar/cava.conf | sed -u 's/;//g;s/0/0/g;s/1/1/g;s/2/2/g;s/3/3/g;s/4/4/g;s/5/5/g;s/6/6/g;s/7/7/g;s/8/8/g;s/9/9/g;' "
    },

    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        // "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C",
        "format-icons": ["", "", ""],

	"interval":1
    },
	
    "temperature#again": {
	"hwmon-path":"/sys/class/hwmon/hwmon2/temp3_input",
	"format": "CPU (TCCD1): {temperatureC}°C",

	"interval":1
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
},
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface,
        "format-ethernet": "{bandwidthTotalBytes}",
        "tooltip-format": "{ipaddr}",
        //"format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
	"interval":1
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} | {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "alsa_output.usb-Topping_D90_MQA-00.HiFi__Headphones__sink":"D90",
	    "alsa_output.usb-BEHRINGER_UMC204HD_192k-00.Direct__Direct__sink":""
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format" : "⏻",
        "on-click": "~/.config/rofi/powermenu/type-5/powermenu.sh"
    },
    "user": {
	"format": "{work_H}:{work_M}:{work_S}",
	"interval":1	
    }
}
